# Copy to backend/.env on the server and fill in. Never commit the real file.
# Start from your Emergent backend/.env: keep all TWILIO_*, META_*, CASHFREE_*,
# JWT_SECRET_KEY and other values as they are, and change the ones marked CHANGE.

# --- Database (CHANGE: MongoDB Atlas) ------------------------------------
MONGO_URL=mongodb+srv://<user>:<password>@salonhub.s3udxut.mongodb.net/?retryWrites=true&w=majority
DB_NAME=<same DB_NAME as on Emergent>

# --- Auth -----------------------------------------------------------------
# Keep the SAME value as Emergent, or every logged-in user gets logged out.
JWT_SECRET_KEY=
# NEW: Google OAuth client ID (Google Cloud Console → Credentials).
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# --- AI menu parsing (NEW: replaces EMERGENT_LLM_KEY) ---------------------
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-pro

# --- Public URLs (CHANGE all to your domain) --------------------------------
CORS_ORIGINS=https://salonhub.in,https://www.salonhub.in
REACT_APP_BACKEND_URL=https://salonhub.in
BACKEND_PUBLIC_URL=https://salonhub.in
PUBLIC_BACKEND_URL=https://salonhub.in
PUBLIC_BASE_URL=https://salonhub.in
PUBLIC_APP_URL=https://salonhub.in
PUBLIC_FRONTEND_URL=https://salonhub.in
FRONTEND_PUBLIC_URL=https://salonhub.in
FRONTEND_BASE_URL=https://salonhub.in
APP_URL=https://salonhub.in
APP_BASE_URL=https://salonhub.in
PUBLIC_WEBHOOK_BASE=https://salonhub.in

# --- WhatsApp / SMS (copy from Emergent) ------------------------------------
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_SENDER=
TWILIO_WHATSAPP_SENDER_SID=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_BOOKING_CONFIRMATION_TEMPLATE_SID=
TWILIO_BOOKING_COMPLETED_TEMPLATE_SID=
TWILIO_TOKEN_APPROACHING_TEMPLATE_SID=
TWILIO_YOUR_TURN_NOW_TEMPLATE_SID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=
META_WA_APP_SECRET=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_PHONE_NUMBER_ID=
META_WA_DISPLAY_NUMBER=
META_WA_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WA_INVOICE_TEMPLATE_NAME=
META_WA_INVOICE_TEMPLATE_LANG=
META_WA_INVOICE_REVIEW_PATH=

# --- Payments (copy from Emergent) --------------------------------------------
CASHFREE_ENV=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=

# --- Misc (copy from Emergent if present) -------------------------------------
PLATFORM_OWNER_MOBILE=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_EMAIL=
ENVIRONMENT=production
