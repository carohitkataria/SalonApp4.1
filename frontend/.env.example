# Copy to frontend/.env on the server. These are baked into the JS bundle at
# build time, so rebuild (`docker compose up -d --build`) after changing them.
REACT_APP_BACKEND_URL=https://salonhub.in
# NEW: same Google OAuth client ID as the backend's GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# Copy the rest from your Emergent frontend/.env.
REACT_APP_CASHFREE_MODE=production
REACT_APP_META_APP_ID=
REACT_APP_META_EMBEDDED_SIGNUP_CONFIG_ID=
