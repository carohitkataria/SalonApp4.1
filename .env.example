# Copy to `.env` (next to docker-compose.yml). Used by docker compose only.
# Your domain, without https:// — Caddy gets the HTTPS certificate for it.
DOMAIN=salonhub.in

# Shifain on the same server (remove these two lines to run SalonHub alone).
COMPOSE_FILE=docker-compose.yml:docker-compose.shifain.yml
SHIFAIN_DOMAIN=shifain.com
